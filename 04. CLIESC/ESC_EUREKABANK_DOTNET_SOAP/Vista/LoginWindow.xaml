<Window x:Class="ec.edu.monster.vista.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EurekaBank"
        Height="620"
        Width="760"
        MinHeight="560"
        MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Gris100}"
        FontFamily="{StaticResource Fuente}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Tarjeta}"
                Width="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <Image Source="/Recursos/monstruo_mike.png"
                       Height="88"
                       Stretch="Uniform"
                       HorizontalAlignment="Center" />
                <TextBlock Text="EurekaBank"
                           Style="{StaticResource Titulo}"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0" />
                <TextBlock Text="Banca en línea · Servicio SOAP / .NET"
                           Style="{StaticResource Subtitulo}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Padding="50,0,50,18"
                Background="Transparent">
            <TextBlock x:Name="EstadoTexto"
                       Text="Comprobando servicio…"
                       Style="{StaticResource Caption}" />
        </Border>
    </Grid>
</Window>
