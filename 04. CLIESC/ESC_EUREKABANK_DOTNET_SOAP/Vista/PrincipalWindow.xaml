<Window x:Class="ec.edu.monster.vista.PrincipalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controles="clr-namespace:ec.edu.monster.vista.controles"
        Title="EurekaBank"
        Height="760"
        Width="1180"
        MinHeight="640"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Gris100}"
        FontFamily="{StaticResource Fuente}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource Marca900}" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="40"
                        Height="40"
                        CornerRadius="9"
                        Background="{StaticResource Marca500}"
                        VerticalAlignment="Center">
                    <TextBlock Text="EB"
                               Foreground="{StaticResource Blanco}"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="EurekaBank"
                                   Foreground="{StaticResource Blanco}"
                                   FontSize="20"
                                   FontWeight="Bold" />
                        <Border Background="{StaticResource ServicioSoap}"
                                CornerRadius="9"
                                Padding="8,2"
                                Margin="10,2,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="SOAP"
                                       Foreground="{StaticResource Blanco}"
                                       FontSize="10"
                                       FontWeight="Bold" />
                        </Border>
                        <Border Background="{StaticResource ServicioDotnet}"
                                CornerRadius="9"
                                Padding="8,2"
                                Margin="6,2,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text=".NET"
                                       Foreground="{StaticResource Blanco}"
                                       FontSize="10"
                                       FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Banca en línea · Servicio SOAP / .NET"
                               Foreground="{StaticResource Marca100}"
                               FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NombreVisible}"
                                   Foreground="{StaticResource Blanco}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding TipoUsuario}"
                                   Foreground="{StaticResource Marca100}"
                                   FontSize="12"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Content="Cerrar sesión"
                            Style="{StaticResource BotonSecundario}"
                            Padding="14,7"
                            Click="CerrarSesion" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: sidebar + content host -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Blanco}"
                    BorderBrush="{StaticResource Gris300}"
                    BorderThickness="0,0,1,0"
                    Padding="16,20">
                <StackPanel>
                    <TextBlock Text="MENÚ"
                               Style="{StaticResource Caption}"
                               FontWeight="SemiBold"
                               Margin="14,0,0,10" />
                    <Button Content="Depósito"
                            Style="{StaticResource BotonNavegacion}"
                            IsEnabled="False" />
                    <Button Content="Retiro"
                            Style="{StaticResource BotonNavegacion}"
                            IsEnabled="False" />
                    <Button Content="Transferencia"
                            Style="{StaticResource BotonNavegacion}"
                            IsEnabled="False" />
                    <Button Content="Consultar movimientos"
                            Style="{StaticResource BotonNavegacion}"
                            IsEnabled="False" />
                    <TextBlock Text="Las operaciones se habilitan en la siguiente entrega."
                               Style="{StaticResource Caption}"
                               Margin="14,12,0,0" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1" Padding="28">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Bienvenido, "
                                   Style="{StaticResource TituloSeccion}" />
                        <TextBlock Text="{Binding NombreVisible}"
                                   Style="{StaticResource TituloSeccion}" />
                    </StackPanel>
                    <TextBlock Text="Seleccione una operación para continuar."
                               Style="{StaticResource Subtitulo}"
                               Margin="0,4,0,0" />

                    <Border Style="{StaticResource Tarjeta}" Margin="0,20,0,0">
                        <StackPanel>
                            <Image Source="/Recursos/monstruos_bienvenida.png"
                                   Height="180"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center" />
                            <TextBlock Text="Su sesión está iniciada."
                                       Style="{StaticResource Cuerpo}"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0" />
                            <TextBlock Text="Use el menú de la izquierda para operar sobre las cuentas."
                                       Style="{StaticResource Subtitulo}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{StaticResource Blanco}"
                BorderBrush="{StaticResource Gris300}"
                BorderThickness="0,1,0,0"
                Padding="28,10">
            <controles:IndicadorEstado x:Name="IndicadorEstadoControl" />
        </Border>
    </Grid>
</Window>
